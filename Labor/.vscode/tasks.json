{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "asciitoctor-html",
            "type": "shell",            
            "command": "docker run --rm -it -v .:/documents asciidoctor/docker-asciidoctor asciidoctor -a githash=${input:githash} -r asciidoctor-diagram -a data-uri -allow-uri-read -D out/html -v -w modules/**/*.doc.adoc ",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated"
            },                     
        }
        ,
        {
            "label": "asciitoctor-html-all",
            "type": "shell",            
            "command": "docker run --rm -it -v .:/documents asciidoctor/docker-asciidoctor asciidoctor -a githash=${input:githash} -r asciidoctor-diagram -a data-uri -allow-uri-read -D out/ -v -w modules/*.all.adoc ",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated"
            },                     
        },
        {
             "label": "deploy docs",
            "type": "shell",      
            "command": "${command:python.interpreterPath}",  
            "args": [
                "build/deploy.py", "--destdir", "SOTE2/lab", "--type", "docs", "--basedir", "out"
            ],                
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated"
            },      
        },
        {
            "label": "deploy solution",
            "type": "shell",            
            "command": "${command:python.interpreterPath}",  
            "args": [
                "build/deploy.py", "--destdir", "SOTE2/lab/solutions", "--type", "solution"
            ],              
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated"
            },   
        }
        ,
        {
            "label": "deploy task input",
            "type": "shell",            
            "command": "${command:python.interpreterPath}",  
            "args": [
                "build/deploy.py", "--destdir", "SOTE2/lab/inputs", "--type", "input"
            ],              
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated"
            },   
        }
        ,
        {
            "label": "delete solutions",
            "type": "shell",      
            "command": "${command:python.interpreterPath}",  
            "args": [
                "build/delete_solutions.py", "--basedir", "SOTE2/lab/solutions", "--extension", "*.zip"
            ],                
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated"
            },   
        }
    ]
    ,
    "inputs": [
        {        
            "id": "githash",
            "type": "command",
            "command": "shellCommand.execute",
                "args": {
                    "command": "git rev-parse --short HEAD",
                    "useSingleResult": true
                }   
        },
        
    ]
}